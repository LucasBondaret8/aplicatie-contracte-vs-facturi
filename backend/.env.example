# Copiază fișierul ca backend/.env și completează cheile. backend/.env nu ajunge pe GitHub (.gitignore).
# Cheile le găsești în Supabase: butonul „Connect” sau Project Settings → API Keys.

# Supabase: facturile (bucket „facturi”, în locul SPV) și contractele (bucket „contracte”)
SUPABASE_URL=https://uoxoihfuztqsdiwbizsc.supabase.co
# cheia publică (sb_publishable_...) ajunge pentru aplicație
SUPABASE_KEY=
# cheia secretă (sb_secret_...) – doar pentru demo_supabase/upload.py, care urcă fișierele
SUPABASE_SECRET_KEY=

# opțional: extragerea contractelor cu Claude (fără ea, aplicația citește contractul fără AI)
ANTHROPIC_API_KEY=
